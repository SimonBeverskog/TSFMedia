{
  "name": "tsfmedia",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "1.9.1"
    },
    "@oclif/core": {
      "minimatch": "11.0.9"
    },
    "eslint-plugin-jsx-a11y-x": {
      "minimatch": "11.0.9"
    }
  },
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "check": "tsc --noEmit && eslint .",
    "schema:deploy": "sanity schemas deploy",
    "typegen": "sanity schemas extract --force && sanity typegen generate",
    "content:import-demo": "sanity exec scripts/import-demo.ts --with-user-token",
    "test:cms": "sanity exec scripts/smoke-test.ts --with-user-token",
    "dev": "sanity dev",
    "start": "sanity start"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/client": "^8.17.0",
    "@sanity/icons": "^5.4.0",
    "@sanity/locale-sv-se": "^1.2.38",
    "@sanity/ui": "^4.4.12",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.25.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7",
    "@types/node": "^26.6.10",
    "@types/react": "^19.2.14",
    "eslint": "^10.8.1",
    "prettier": "^3.5",
    "typescript": "~6.0"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
